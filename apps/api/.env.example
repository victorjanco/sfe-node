# ---------------------------------------------------------------------------
# SFE Node — entorno de ejecución (API NestJS)
# Copiar a .env y cambiar valores para el entorno correspondiente.
# ---------------------------------------------------------------------------

# --- Servidor ---------------------------------------------------------------
PORT=3000
# Orígenes CORS (separados por coma). En desarrollo Vite proxpea /api, sobra.
# CORS_ORIGIN="https://sfe.example.bo,https://panel.example.bo"

# --- Base de datos ---------------------------------------------------------
# SQLite (demo local) — sin necesidad de servidor
DATABASE_URL="file:./dev.db"
# PostgreSQL (producción / piloteo real) — descomentar:
# DATABASE_URL="postgresql://sfe:sfe@localhost:5432/sfe?schema=public"

# --- Autenticación JWT ------------------------------------------------------
# OBLIGATORIO en producción. NUNCA dejar el valor por defecto.
JWT_SECRET="cambiar-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="12h"

# --- Integración SIAT (Servicio de Impuestos Nacionales BO) -----------------
#
# MODO DEMO (por defecto): SIAT_ENABLED=false
#   Las facturas se registran localmente y los SOAP responses son stubs
#   locales (prefijo REC-*). Adecuado para desarrollo y QA.
#
# MODO REAL (SOAP contra SIAT): SIAT_ENABLED=true
#   Obligatorio además:
#     1. Token oficial de SIN (SIAT_TOKEN)
#     2. Certificados en apps/api/keys/: certificado.pem y claveprivadakey.pem
#        o bien SIAT_PUBLIC_KEY / SIAT_PRIVATE_KEY con el contenido en una
#        sola línea (saltos de línea reemplazados por \n).
#     3. NIT, modalidad, ambiente y código de sistema coincidentes con
#        los registrados en SIN.
#     4. CUIS y CUFD vigentes sincronizados (pantalla SIAT del front).
#
SIAT_ENABLED=false
SIAT_BASE_URL="https://pilotosiatservicios.impuestos.gob.bo/v2"
SIAT_TOKEN="TokenApi-Cambiar"
SIAT_AMBIENTE=2        # 1=Producción, 2=Pruebas (Piloto)
SIAT_MODALIDAD=2       # 1=Computarizada en línea, 2=Computarizada fuera de línea
SIAT_SISTEMA="95FC61B3BA7"      # Código de sistema otorgado por SIN
SIAT_NIT="370395025"            # NIT de la empresa (13 dígitos, sin DV)
SIAT_RAZON_SOCIAL="FACTURACION IC S.R.L."

# SIAT_KEYS_DIR=./apps/api/keys   # Directorio alternativo para certificados

# --- Swagger / OpenAPI -----------------------------------------------------
# Por defecto: habilitado en ambiente 2 (pruebas), deshabilitado en 1 (prod).
# Forzar con SWAGGER_ENABLED=true/false.
# SWAGGER_ENABLED=true
